# Required. Safe for the browser, but use your own project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-only product extraction. Never prefix these with NEXT_PUBLIC_.
# Amazon uses Bright Data's documented product dataset by default.
# BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_AMAZON_DATASET_ID=gd_l7q7dkf244hwjntr0
# Copy the dataset IDs for these scrapers from your Bright Data dashboard.
# BRIGHT_DATA_FLIPKART_DATASET_ID=
# BRIGHT_DATA_MYNTRA_DATASET_ID=
# Optional fallback dataset for other product sites.
# BRIGHT_DATA_PRODUCT_DATASET_ID=
# Optional location context used by Amazon pricing.
# BRIGHT_DATA_POSTCODE=

# Optional server-only shopping comparison provider.
# SERPAPI_API_KEY=

# Optional server-only OCR text structuring. No NEXT_PUBLIC_ prefix.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Optional scheduled price checks. Keep both server-only and configure in Vercel.
# SUPABASE_SECRET_KEY=sb_secret_...
# CRON_SECRET=use_a_random_high_entropy_secret
